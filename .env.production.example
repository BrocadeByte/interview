# Copy this file to .env.production and replace every replace_* value.
# Passwords are embedded in connection URLs; use URL-safe characters such as
# letters, numbers, underscores, hyphens and dots.

# MySQL
MYSQL_DATABASE=ai_interview
MYSQL_USER=ai_interview
MYSQL_PASSWORD=replace_with_database_password
MYSQL_ROOT_PASSWORD=replace_with_root_database_password

# RabbitMQ
RABBITMQ_USER=ai_interview
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_BIND=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PREFETCH_COUNT=2
RABBITMQ_CONNECT_TIMEOUT_SECONDS=10
RABBITMQ_INGESTION_QUEUE=knowledge.ingestion
RABBITMQ_INGESTION_EXCHANGE=knowledge.ingestion.exchange
RABBITMQ_INGESTION_DLX=knowledge.ingestion.dlx
RABBITMQ_RESUME_QUEUE=resume.parsing
RABBITMQ_RESUME_EXCHANGE=resume.parsing.exchange
RABBITMQ_RESUME_DLX=resume.parsing.dlx

# Generate these independently with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_64_character_random_secret
REFRESH_JWT_SECRET_KEY=replace_with_an_independent_64_character_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
HEALTHCHECK_TIMEOUT_SECONDS=2

# Keep false for direct HTTP. Set true after HTTPS is enabled.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# OpenAI-compatible chat model. DeepSeek is the default example.
OPENAI_API_KEY=replace_with_model_api_key
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
RESUME_PARSE_MODEL=
RESUME_PARSE_TIMEOUT_SECONDS=120
# The following two options apply only to resume parsing, not interview generation or scoring.
RESUME_PARSE_JSON_MODE=true
RESUME_PARSE_THINKING_MODE=disabled

# Qdrant is included in Compose. Replace the URL only when using an external service.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=knowledge_documents

# Semantic retrieval and reranking. A DashScope key is required for these defaults.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_SCORE_THRESHOLD=0.35
EMBEDDING_TIMEOUT_SECONDS=30
ALLOW_HASH_EMBEDDINGS=false
DASHSCOPE_API_KEY=replace_with_dashscope_api_key
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TIMEOUT_SECONDS=20
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_DENSE_CANDIDATE_LIMIT=30
RAG_BM25_CANDIDATE_LIMIT=30
RAG_RERANK_LIMIT=8
RAG_ADJACENT_CHUNK_WINDOW=1
RAG_CONTEXT_TOKEN_BUDGET=6000

# Optional: required only for knowledge-file storage in Aliyun OSS.
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PREFIX=knowledge/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Public web entry. Use HTTP_BIND=127.0.0.1 behind a local reverse proxy.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
